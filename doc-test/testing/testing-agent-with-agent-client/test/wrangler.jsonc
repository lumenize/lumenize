{
  "name": "testing-agent-with-agent-client",
  "main": "./test-harness.ts",  // The only difference from real wrangler.jsonc
  "compatibility_date": "2026-03-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "exports": {
    "ChatAgent": { "type": "durable-object", "storage": "sqlite" },
    "AuthAgent": { "type": "durable-object", "storage": "sqlite" }
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "ChatAgent",
        "name": "CHAT_AGENT"
      },
      {
        "class_name": "AuthAgent",
        "name": "AUTH_AGENT"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "SESSION_STORE",
      "id": "preview_id"
    }
  ]
}