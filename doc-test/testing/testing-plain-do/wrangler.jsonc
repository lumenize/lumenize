{
  "name": "testing-agent-with-agent-client",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "exports": {
    "MyDO": { "type": "durable-object", "storage": "sqlite" }
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "MyDO",
        "name": "MY_DO"
      }
    ]
  }
}