# Cloudflare
.wrangler
# Written into the CWD by `wrangler check startup --workerBundle` — the startup-cost
# measurement `workflow.md` documents, so anyone following that procedure produces one.
*.cpuprofile
# Derived per harness boot from apps/nebula/wrangler.jsonc (container build commented out).
# Must sit beside the original because wrangler resolves relative paths against the config's dir.
wrangler.harness-no-container.jsonc
.dev.vars

# node-localstorage
.scratch

# Experiments — tracked by default. Prune stale dirs when their results are
# captured elsewhere; keep package.json "workspaces" curated to active experiments.
# Per-experiment node_modules/dist/.wrangler/coverage/__screenshots__/.dev.vars are
# already covered by the global rules above. These cover generated/raw artifacts only:
experiments/**/*-raw-*.json
experiments/tsgo-benchmarks/schemas/
# dep-restore-bench: ~110 MB of node_modules tarballs/squashfs regenerated by bench-restore.sh
experiments/container-dep-restore-bench/artifacts/

# ui-smoke: sandbox egress-proxy CA staged into the DevContainer build context by
# test/ui-smoke/global-setup.ts (prod-inert Dockerfile hook). Never commit it.
apps/nebula/container/ccr-ca.crt

# vitest
.vitest-cache
.vitest-attachments
coverage
durable-objects/coverage
__screenshots__
vitest.config.*.timestamp-*.mjs
