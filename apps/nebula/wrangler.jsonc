{
  "name": "nebula",
  "main": "src/worker.ts",
  "compatibility_date": "2026-04-01",
  // nodejs_compat is REQUIRED: DevStudio (bound below) transitively imports
  // isomorphic-git + @cloudflare/shell, which import `node:` builtins (buffer/crypto/
  // path/os). Use plain `nodejs_compat` (NOT the legacy `nodejs_compat_v2` flag-name):
  // with our compat_date it already gives v2 semantics, AND it actually resolves
  // `node:` builtins in real `wrangler dev` (4.x). The bare `nodejs_compat_v2` flag
  // does NOT — a `node:os`/etc. import crashes startup with `No such module`
  // (vitest-pool-workers masks this with its own polyfills, but prod deploy + the
  // real-browser harnesses run real workerd). Must match every other wrangler that
  // loads apps/nebula DOs (test/, baseline, browser) — a flag mismatch lets a green
  // test validate under a different runtime than prod.
  // (Phase 4 retired the old rationale — the @vue/compiler-sfc SFC compiler + vendored
  // tsc bundle were deleted with the in-DO serve path; the flag now survives for
  // DevStudio's isomorphic-git/@cloudflare/shell.)
  "compatibility_flags": ["nodejs_compat"],
  // Branded custom domain. Cloudflare auto-provisions the proxied DNS record + edge cert for this
  // hostname on the `lumenize.com` zone (active on this account) at `wrangler deploy`. Magic-link
  // URLs follow the request origin, so hitting this domain brands them; the JWT issuer
  // (NEBULA_AUTH_ISSUER) is independently `https://nebula.lumenize.com` regardless.
  "routes": [
    { "pattern": "nebula.lumenize.com", "custom_domain": true }
  ],
  // Keep the `*.workers.dev` URL enabled ALONGSIDE the custom domain. Adding `routes` flips
  // wrangler's default to DISABLE workers.dev, so this must be explicit — it's a stable fallback
  // while the custom-domain cert provisions, and keeps `nebula.transformation.workers.dev` live.
  "workers_dev": true,
  "worker_loaders": [{ "binding": "LOADER" }],
  // Workers AI — DevStudio's codegen engine runs the model through this binding (the
  // model id is a swappable constant in dev-studio.ts; Studio is model-agnostic). In
  // local `wrangler dev` this proxies to the account's Workers AI (needs network + the
  // CLOUDFLARE_* creds already in .dev.vars).
  "ai": { "binding": "AI" },
  // Magic-link / invite email. Registry/facade → AUTH_EMAIL_SENDER (self-ref service binding
  // → the NebulaEmailSender WorkerEntrypoint re-exported from src/worker.ts) → the provider
  // `@lumenize/email` selects from env. The provider SPLITS by lane, deliberately:
  //   - DEPLOYED prod: Resend (deliverability, decided 2026-08-09) — selected by the
  //     `--var EMAIL_PROVIDER:resend` scripts/deploy.sh passes, NEVER a var here: every local
  //     lane boots THIS file, and a blanket var would flip the harness off the CF Routing
  //     catch-all that `waitForEmail` depends on.
  //   - `wrangler dev` / the /live harness: the EMAIL binding below → Cloudflare Email Sending
  //     (`remote: true` proxies to the real service during dev), landing in the `*@lumenize.io`
  //     catch-all the email-test Worker reads.
  // The from-address is env-configurable via AUTH_EMAIL_FROM (default auth@nebula.lumenize.com);
  // test/dev harnesses override it to a VERIFIED domain (test@lumenize.io) — an unverified
  // sender is silently dropped (CF) / rejected (Resend).
  "services": [
    { "binding": "AUTH_EMAIL_SENDER", "service": "nebula", "entrypoint": "NebulaEmailSender" },
    // The mesh-speaking facade for authenticated-session Registry mutations (invites). Clients and
    // platform nodes reach it with an ordinary `lmz.call('NEBULA_AUTH_FACADE', undefined, …)` — a
    // service binding with no instance name routes as a LumenizeWorker; the one raw Registry hop
    // lives inside the facade (@lumenize/nebula-auth/facade, re-exported from src/worker.ts).
    { "binding": "NEBULA_AUTH_FACADE", "service": "nebula", "entrypoint": "NebulaAuthFacade" }
  ],
  "send_email": [
    { "name": "EMAIL", "remote": true }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NEBULA_CLIENT_GATEWAY", "class_name": "NebulaClientGateway" },
      { "name": "UNIVERSE", "class_name": "Universe" },
      { "name": "GALAXY", "class_name": "Galaxy" },
      { "name": "STAR", "class_name": "Star" },
      { "name": "DEV_STUDIO", "class_name": "DevStudio" },
      { "name": "DEV_CONTAINER", "class_name": "DevContainer" },
      { "name": "NEBULA_AUTH_REGISTRY", "class_name": "NebulaAuthRegistry" },
      { "name": "PROFILE", "class_name": "Profile" }
    ]
  },
  // Workers KV — the ONE hot refresh-token record (`refresh:{tokenHash}`), written by the registry and
  // read at the edge by the Worker on refresh (tasks/nebula-auth-surrogate-sub.md). The per-scope
  // NebulaAuth DO is dissolved. ⚠️ PHASE-4 (manual): provision the real KV namespace
  // (`wrangler kv namespace create REFRESH_TOKEN_KV`) and replace the placeholder `id` below before the
  // greenfield redeploy.
  "kv_namespaces": [
    { "binding": "REFRESH_TOKEN_KV", "id": "REPLACE_WITH_REAL_KV_NAMESPACE_ID_AT_PHASE_4" }
  ],
  // nebula-auth's two rate limiters. Without these the guards silently no-op (`checkRateLimit`
  // returns allow when unbound) — the Registry's constructor logs `debug.error` naming any absent
  // one. Limits are DELIBERATELY loose placeholders (bound abuse, never legitimate traffic);
  // picking real numbers is a backlog row. `NEBULA_AUTH_RATE_LIMITER` keys on the verified `sub`;
  // `NEBULA_AUTH_CONNECTION_RATE_LIMITER` keys on `CF-Connecting-IP` for the routes that present
  // no token (forged-cookie / open-route faucets) — per-binding limits are why there are two.
  "ratelimits": [
    { "name": "NEBULA_AUTH_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 1000, "period": 60 } },
    { "name": "NEBULA_AUTH_CONNECTION_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 1000, "period": 60 } }
  ],
  // DevContainer runs the dev-loop vite preview (5173 public) + command-server
  // (9000, host-DO-only). Image is baked (deps + framework skeleton) → 0 npm
  // install on cold boot. Deploy via Docker Desktop + WARP ([[cf-container-deploy-proxy]]).
  //
  // instance_type = standard-2 (1 vCPU / 6 GiB). ⚠️ Do NOT drop back to standard-1
  // (½ vCPU): the old "standard-1 clears the `vite build` starvation bar" sizing held
  // only for the trivial seed App.vue.
  //
  // Measured ON REAL CF 2026-07-20 (experiments/container-cold-start-probe — trust these
  // over the LOCAL-Docker figures in container-dep-restore-bench, which proved 3–5×
  // optimistic). Building a small app with one charting lib, holding colo constant:
  // standard-1 ≈ 21–26 s vs standard-4 ≈ 7.7–8.7 s — roughly 2.7× for sizing up. Cost
  // partly follows: CF bills per vCPU-second while RUNNING, so a shorter build claws
  // back much of the higher rate.
  //
  // ⚠️ But sizing is NOT the dominant term, and standard-2 is a hedge, not an optimum:
  //   - COLO dominates. Containers do NOT run where the caller enters (entry was IAD on
  //     every probe run; containers landed in MIA/EWR/CMH/YYZ). One colo (EWR) built in
  //     ~28 s at BOTH standard-1 and standard-4 — sizing bought nothing there. Picking
  //     DO ids/names cannot buy local placement.
  //   - The evidence is n=3–5 per cell with colo uncontrolled; the sizing result rests on
  //     3 colo-matched pairs. Directionally sound, not powered. standard-4 may well be
  //     better; resolving it needs many samples per (instance_type × colo) cell.
  // Revisit with a powered experiment before spending more here.
  "containers": [
    {
      "max_instances": 10,
      "class_name": "DevContainer",
      "image": "./container/Dockerfile",
      "instance_type": "standard-2"
    }
  ],
  // Serve the Studio SPA from Workers Assets (declarative routing — no Worker code).
  // `directory` is the `vite build` output of apps/nebula-studio-ui (gitignored; built
  // by deploy.sh BEFORE `wrangler deploy` so the upload sees it). `run_worker_first` is a
  // ROUTE LIST, not `true`: the Worker runs first ONLY for these API prefixes + /_version;
  // every other path is served directly by the assets layer (SPA index.html for /, /app,
  // and any unmatched path) WITHOUT invoking the Worker — so the shared entrypoint.ts is
  // untouched and never references env.ASSETS (no binding read in code; no terminal guard).
  //   - `*` is DEEP-matching: "glob patterns with * for deep matching" — it matches zero or
  //     more of ANY character, crossing path segments AND dots (CF docs / 2025-06-17 advanced
  //     -routing changelog; the `/api/*` example matches the multi-segment `/api/docs/*`). So
  //     `/dev-container/*` matches the deep dotted preview sub-assets
  //     (`/dev-container/acme.app.dev/assets/index-<hash>.js`) → Worker-served, not shadowed
  //     by the SPA. `!`-negation is also supported (negative patterns take precedence); unused
  //     here. Verified against the CF docs at build time (nebula-release-process.md, m-3).
  //   - PROD config ONLY — NOT the baseline test-app, NOT the bench worker (their wranglers
  //     have no assets layer by design). `binding` is declared for convention/forward-compat
  //     but no code reads env.ASSETS, so no `npm run types` regen is required.
  //   - ⚠️ wrangler HARD-ERRORS if `directory` is ABSENT (an EMPTY dir is fine — reads 0
  //     files). `dist` is gitignored (built by deploy.sh before `wrangler deploy`), so the
  //     `wrangler dev` lanes that load THIS config (the `dev` npm script + the ui-smoke
  //     global-setup) `mkdir -p ../nebula-studio-ui/dist` first — zero-build, keeps a fresh
  //     checkout's dev loop working. The empty assets layer is inert under `wrangler dev`:
  //     the browser hits vite (:5174); only the run_worker_first API prefixes reach here.
  "assets": {
    "directory": "../nebula-studio-ui/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/auth/*", "/gateway/*", "/dev-container/*", "/_version"]
  },
  // Declarative DO class registry — `exports` (NOT SQL migration; replaced the old `migrations` array,
  // tasks/archive/do-exports-and-toolchain-upgrade.md). Every class is `storage: "sqlite"` — all use sync storage
  // (LumenizeContainer persists identity in ctx.storage.kv; `storage: "legacy-kv"` would make sync
  // storage throw → hard deploy failure, so the audit-migrations.mjs preflight reds on any non-sqlite).
  // ⚠️ DEPLOY COUPLING — do NOT just `wrangler deploy`. Prod IS live (nebula.lumenize.com, 2026-07-04)
  // and was last deployed under the `migrations` model. Switching a live worker `migrations`→`exports`
  // via a plain incremental `wrangler deploy` may be rejected. This conversion lands ONLY via the frozen
  // wipe runbook — a full CF-DASHBOARD worker-delete (clears all DO storage + registry history —
  // [[wrangler-delete-leaves-do-data]]) then a FRESH deploy, at which point this `exports` map is the
  // clean starting state. Runbook: Phase 4 of the frozen archive tasks/archive/nebula-auth-surrogate-sub.md
  // (reached via nebula-pre-alpha.md:88) — its `migrations`-shaped steps are superseded by the exports-aware
  // audit; follow do-exports-and-toolchain-upgrade.md Phase 4, not the frozen narration.
  "exports": {
    "NebulaClientGateway": { "type": "durable-object", "storage": "sqlite" },
    "Universe": { "type": "durable-object", "storage": "sqlite" },
    "Galaxy": { "type": "durable-object", "storage": "sqlite" },
    "Star": { "type": "durable-object", "storage": "sqlite" },
    "DevStudio": { "type": "durable-object", "storage": "sqlite" },
    "DevContainer": { "type": "durable-object", "storage": "sqlite" },
    "NebulaAuthRegistry": { "type": "durable-object", "storage": "sqlite" },
    "Profile": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    "PRIMARY_JWT_KEY": "BLUE",
    "NEBULA_AUTH_REDIRECT": "/app",
    // Pre-alpha observability — @lumenize/debug gates ALL output (even errors) on this, so prod is
    // otherwise silent. SAFE to leave ON for pre-alpha (incl. real F&F) because no log statement may
    // emit a secret (security.md § Never log secrets — audited clean 2026-06-26: identifiers +
    // pathnames only, never tokens/JWTs/links/full-URLs). Revisit at alpha/public for log volume +
    // cost, and to scope it down. Emails/subs are identifiers (not secrets) and may be logged.
    "DEBUG": "auth,nebula-auth,nebula,mesh,routing",
    // Magic-link / invite from-address. MUST be a CF-verified Email Sending sender or CF SILENTLY
    // DROPS the mail. The shared nebula-auth code default (`auth@nebula.lumenize.com`) is NOT
    // verified; `lumenize.io` IS, so send from it (no DNS work). The app ORIGIN + JWT issuer stay
    // `nebula.lumenize.com`; only the email sender rides the verified `lumenize.io` until CF
    // subdomain email support lands (→ tasks/backlog.md § Nebula Auth). B2, nebula-release-process.md.
    "AUTH_EMAIL_FROM": "noreply@lumenize.io",
    // Comma-separated origins allowed to call this Worker from a browser.
    // Empty = same-origin only (safe default for the single-origin lumenize.com deploy).
    // Custom-domain deploys and real-browser test rigs override this per environment.
    "LUMENIZE_APPROVED_ORIGINS": ""
  }
}
