{
  // Container-node test-app. Its tests are all PURE / prototype-level (NebulaContainer and
  // DevContainer both `extend Container`, unconstructable under pool-workers), so NO Durable Object
  // is registered — the worker is a stub entry point. nodejs_compat matches the other nebula
  // wranglers. Not in `npm test`; run with `npx vitest run --project container`.
  "name": "nebula-container-node-test",
  "main": "../index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"]
}
