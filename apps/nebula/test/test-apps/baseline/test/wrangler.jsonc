{
  "name": "nebula-baseline-test",
  "main": "./test-harness.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "worker_loaders": [{ "binding": "LOADER" }],
  "durable_objects": {
    "bindings": [
      { "name": "UNIVERSE", "class_name": "Universe" },
      { "name": "GALAXY", "class_name": "GalaxyTest" },
      { "name": "STAR", "class_name": "StarTest" },
      { "name": "AUTH_REGISTRY", "class_name": "AuthRegistry" },
      { "name": "PROFILE", "class_name": "ProfileTest" }
    ]
  },
  // The per-scope NebulaAuth DO is dissolved (tasks/nebula-auth-surrogate-sub.md); refresh state lives
  // in the REFRESH_TOKEN_KV namespace below.
  "kv_namespaces": [
    { "binding": "REFRESH_TOKEN_KV", "id": "nebula-baseline-refresh-token-kv-test" }
  ],
  "exports": {
    "Universe": { "type": "durable-object", "storage": "sqlite" },
    "GalaxyTest": { "type": "durable-object", "storage": "sqlite" },
    "StarTest": { "type": "durable-object", "storage": "sqlite" },
    "AuthRegistry": { "type": "durable-object", "storage": "sqlite" },
    "ProfileTest": { "type": "durable-object", "storage": "sqlite" }
  },
  "services": [
    {
      "binding": "AUTH_EMAIL_SENDER",
      "service": "nebula-baseline-test",
      "entrypoint": "NebulaEmailSender"
    },
    // The mesh-speaking invite facade — reached by clients via
    // `lmz.call('AUTH_FACADE', undefined, …)` (Worker binding, no instance name).
    {
      "binding": "AUTH_FACADE",
      "service": "nebula-baseline-test",
      "entrypoint": "NebulaAuthFacade"
    },
    // The platform host's own routes, reached for `/` and `/auth/*` on the platform host.
    {
      "binding": "PLATFORM_HOST",
      "service": "nebula-baseline-test",
      "entrypoint": "PlatformHost"
    }
  ],
  "vars": {
    // The deployment's origin, which every host and the JWT issuer derive from (nebula-auth `hosts.ts`).
    "LUMENIZE_ORIGIN": "http://lumenize.localhost",
    "PRIMARY_JWT_KEY": "BLUE"
  }
}
