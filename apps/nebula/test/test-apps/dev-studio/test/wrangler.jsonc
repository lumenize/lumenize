{
  // Galaxy codegen test (the `dev-studio` project — its name predates the collapse).
  // GalaxyLoopProbe (the @cloudflare/computer Workspace + host-side git + the codegen
  // loop with a scripted model) + DevStarOntologyProbe (the `{u}.{g}.dev` apply target)
  // + LOADER (the validator facet). nodejs_compat is REQUIRED: @cloudflare/computer +
  // isomorphic-git touch node: builtins. Run with `npx vitest run --project dev-studio`.
  "name": "nebula-dev-studio-test",
  "main": "../index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "worker_loaders": [{ "binding": "LOADER" }],
  "durable_objects": {
    "bindings": [
      { "name": "GALAXY", "class_name": "GalaxyLoopProbe" },
      { "name": "GALAXY_DEADLINE", "class_name": "GalaxyDeadlineProbe" },
      { "name": "STAR", "class_name": "DevStarOntologyProbe" }
    ]
  },
  "exports": {
    "GalaxyLoopProbe": { "type": "durable-object", "storage": "sqlite" },
    "GalaxyDeadlineProbe": { "type": "durable-object", "storage": "sqlite" },
    "DevStarOntologyProbe": { "type": "durable-object", "storage": "sqlite" }
  }
}
