{
  "name": "test-endpoints",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-12",
  "observability": {
    "enabled": true
  },
  "vars": {
    "DEBUG": "changed-value"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TEST_ENDPOINTS_DO",
        "class_name": "TestEndpointsDO"
      },
      {
        "name": "ENV_TEST_DO",
        "class_name": "EnvTestDO"
      }
    ]
  },
  "exports": {
    "TestEndpointsDO": { "type": "durable-object", "storage": "sqlite" },
    "EnvTestDO": { "type": "durable-object", "storage": "sqlite" }
  }
}
