{
  "name": "experiment-merge-patch-sql",
  "main": "./src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "PATCH", "class_name": "PatchDO" }]
  },
  "exports": {
    "PatchDO": { "type": "durable-object", "storage": "sqlite" }
  },
  // Workers Logs is the capture: each object invocation's record carries its cpuTimeMs and
  // wallTimeMs, which is what the object's own clock cannot give (experiments/do-read-cache).
  "observability": { "logs": { "enabled": true, "invocation_logs": true } }
}
