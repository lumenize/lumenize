{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Throwaway (2026-09-15): does a second Worker's *.test.lumenize.dev/* route win over
  // *.lumenize.dev/* for hosts under test.lumenize.dev? RESULTS.md § Route precedence.
  // Delete the Worker from the DASHBOARD.
  "name": "experiment-wildcard-hosts-test",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-26",
  "workers_dev": false,
  "routes": [
    { "pattern": "*.test.lumenize.dev/*", "zone_name": "lumenize.dev" },
    { "pattern": "*.test--lmz.lumenize.dev/*", "zone_name": "lumenize.dev" }
  ],
  "vars": { "ARM": "test-suffix" },
  "observability": { "enabled": true }
}
