{
  "name": "experiment-asof-index-cost",
  "main": "./src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ASOF", "class_name": "AsOfDO" }]
  },
  "exports": {
    "AsOfDO": { "type": "durable-object", "storage": "sqlite" }
  },
  // Workers Logs is the capture: each object invocation's record carries its cpuTimeMs and
  // wallTimeMs, which the object's own clock cannot give (experiments/do-read-cache).
  "observability": { "logs": { "enabled": true, "invocation_logs": true } }
}
