{
  "name": "experiment-do-socket-drop-probe",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "PROBE", "class_name": "ProbeDO" }]
  },
  "exports": {
    "ProbeDO": { "type": "durable-object", "storage": "sqlite" }
  },
  "observability": { "enabled": false }
}
