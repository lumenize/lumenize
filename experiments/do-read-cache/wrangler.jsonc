{
  "name": "experiment-do-read-cache",
  "main": "./src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "PROBE", "class_name": "ProbeDO" }]
  },
  "exports": {
    "ProbeDO": { "type": "durable-object", "storage": "sqlite" }
  },
  // Workers Logs is the capture: each object invocation's record carries its cpuTimeMs and
  // wallTimeMs. wrangler tail delivered none of the object's invocations here (RESULTS.md).
  "observability": { "logs": { "enabled": true, "invocation_logs": true } }
}
