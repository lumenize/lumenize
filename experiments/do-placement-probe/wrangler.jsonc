{
  "name": "experiment-do-placement-probe",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "PROBE", "class_name": "ProbeDO" }]
  },
  "exports": {
    "ProbeDO": { "type": "durable-object", "storage": "sqlite" }
  },
  // The Worker's own entrypoint, so an object can call it the way a host node calls the facade.
  "services": [
    { "binding": "SELF", "service": "experiment-do-placement-probe", "entrypoint": "Toucher" }
  ],
  "observability": { "enabled": false }
}
