{
  "name": "lumenize-testing-integration",
  "main": "test-worker-and-dos.ts",
  "compatibility_date": "2026-08-15",
  "durable_objects": {
    "bindings": [
      {
        "name": "TEST_DO",
        "class_name": "TestDO"
      },
      {
        "name": "INSTANCE_HANDLER_DO",
        "class_name": "InstanceHandlerDO"
      }
    ]
  },
  "exports": {
    "TestDO": { "type": "durable-object", "storage": "sqlite" },
    "InstanceHandlerDO": { "type": "durable-object", "storage": "sqlite" }
  }
}

