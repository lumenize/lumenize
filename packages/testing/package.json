{
  "name": "@lumenize/testing",
  "version": "0.26.0",
  "description": "De✨light✨ful testing utilities for Cloudflare Durable Objects",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./wrangler": {
      "import": "./src/spawn-wrangler-dev.ts",
      "types": "./src/spawn-wrangler-dev.ts"
    }
  },
  "files": [
    "src/**/*"
  ],
  "scripts": {
    "test": "vitest --run",
    "test:coverage": "vitest --coverage --run",
    "coverage": "COVERAGE=true vitest --run --coverage",
    "types": "wrangler types --config test/wrangler.jsonc"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "durable-objects",
    "DurableObjects",
    "Durable Objects",
    "testing",
    "vitest",
    "dx"
  ],
  "author": "Lumenize",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@cloudflare/actors": "^0.0.1-beta.6",
    "@cloudflare/vitest-pool-workers": "^0.18.5",
    "@vitest/coverage-istanbul": "4.1.10",
    "typescript": "^5.9.2",
    "vitest": "4.1.10",
    "wrangler": "^4.111.0"
  },
  "dependencies": {
    "@lumenize/routing": "^0.26.0",
    "@lumenize/rpc": "^0.26.0"
  },
  "peerDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.5",
    "vitest": "4.1.10"
  },
  "gitHead": "59bf07ef73368b771a8fe9446bd8aa91ba96fd5c"
}
