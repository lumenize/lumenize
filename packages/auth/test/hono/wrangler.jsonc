{
  "name": "auth-hono-test",
  "main": "./test-harness.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "LUMENIZE_AUTH",
        "class_name": "LumenizeAuth"
      },
      {
        "name": "ECHO_DO",
        "class_name": "EchoDO"
      }
    ]
  },
  // Self-referencing service binding: AuthEmailSender is a WorkerEntrypoint
  // exported from this same Worker (test-harness.ts)
  "services": [
    {
      "binding": "AUTH_EMAIL_SENDER",
      "service": "auth-hono-test",
      "entrypoint": "AuthEmailSender"
    }
  ],
  "exports": {
    "LumenizeAuth": { "type": "durable-object", "storage": "sqlite" },
    "EchoDO": { "type": "durable-object", "storage": "legacy-kv" }
  },
  "ratelimits": [
    {
      "name": "LUMENIZE_AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ],
  "vars": {
    "PRIMARY_JWT_KEY": "BLUE",
    "LUMENIZE_AUTH_REDIRECT": "/app",
    // Test mail goes through Resend: a binding send to a per-run address counts against
    // Cloudflare's daily sending quota (experiments/email-quota-probe/RESULTS.md).
    "EMAIL_PROVIDER": "resend"
  }
}
