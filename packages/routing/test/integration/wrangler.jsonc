{
  "name": "lumenize-utils-integration-tests",
  "main": "test-worker-and-dos.ts",
  "compatibility_date": "2026-03-12",
  "durable_objects": {
    "bindings": [
      {
        "name": "TEST_DO",
        "class_name": "TestDO"
      },
      {
        "name": "MY_DO",
        "class_name": "MyDO"
      },
      {
        "name": "USER_SESSION",
        "class_name": "UserSession"
      }
    ]
  },
  "exports": {
    "TestDO": { "type": "durable-object", "storage": "sqlite" },
    "MyDO": { "type": "durable-object", "storage": "sqlite" },
    "UserSession": { "type": "durable-object", "storage": "sqlite" }
  }
}
