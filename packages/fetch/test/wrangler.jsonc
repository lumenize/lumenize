{
  "name": "proxy-fetch-live-integration-test",
  "main": "./test-harness.ts",
  "compatibility_date": "2026-03-12",

  "services": [
    {
      "binding": "FETCH_EXECUTOR",
      "service": "proxy-fetch-live-integration-test",
      "entrypoint": "FetchExecutorEntrypoint"
    }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "TEST_SIMPLE_DO", "class_name": "TestSimpleDO" },
      { "name": "TEST_ENDPOINTS_DO", "class_name": "TestEndpointsDO" },
      { "name": "FETCH_EXAMPLE_DO", "class_name": "FetchExampleDO" },
      { "name": "RETRY_EXAMPLE_DO", "class_name": "RetryExampleDO" }
    ]
  },

  "exports": {
    "TestSimpleDO": { "type": "durable-object", "storage": "sqlite" },
    "TestEndpointsDO": { "type": "durable-object", "storage": "sqlite" },
    "FetchExampleDO": { "type": "durable-object", "storage": "sqlite" },
    "RetryExampleDO": { "type": "durable-object", "storage": "sqlite" }
  }
}
