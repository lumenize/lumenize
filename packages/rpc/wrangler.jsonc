    "SubclassDO": { "type": "durable-object", "storage": "sqlite" },
    "PipeliningDO": { "type": "durable-object", "storage": "sqlite" },
    "MyDO": { "type": "durable-object", "storage": "sqlite" },
    "NotificationDO": { "type": "durable-object", "storage": "sqlite" },
    "VideoDO": { "type": "durable-object", "storage": "sqlite" },
    "NotificationHub": { "type": "durable-object", "storage": "sqlite" },
    "DocumentDO": { "type": "durable-object", "storage": "sqlite" },
    "BroadcastDO": { "type": "durable-object", "storage": "sqlite" },
    "MapSetTestDOWithRpc": { "type": "durable-object", "storage": "sqlite" }
  }
