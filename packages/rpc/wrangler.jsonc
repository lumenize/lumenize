      },
      {
        "name": "MY_DO",
        "class_name": "MyDO"
      },
      {
        "name": "NOTIFICATION_DO",
        "class_name": "NotificationDO"
      },
      {
        "name": "VIDEO_DO",
        "class_name": "VideoDO"
      },
      {
        "name": "NOTIFICATIONS",
        "class_name": "NotificationHub"
      },
      {
        "name": "DOCUMENT_DO",
        "class_name": "DocumentDO"
      },
      {
        "name": "BROADCAST_DO",
