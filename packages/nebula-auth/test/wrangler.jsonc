{
  "name": "nebula-auth",
  "main": "test-worker-and-dos.ts",
  "compatibility_date": "2026-03-12",
  "durable_objects": {
    "bindings": [
      {
        "name": "NEBULA_AUTH_REGISTRY",
        "class_name": "NebulaAuthRegistry"
      },
      {
        "name": "BARE_STORAGE_DO",
        "class_name": "BareStorageDO"
      }
    ]
  },
  // DO class registry (NOT SQL migration). The per-scope NebulaAuth DO is dissolved
  // (tasks/nebula-auth-surrogate-sub.md) — only the singleton registry remains.
  "exports": {
    "NebulaAuthRegistry": { "type": "durable-object", "storage": "sqlite" },
    "BareStorageDO": { "type": "durable-object", "storage": "sqlite" }
  },
  // Workers KV — the ONE hot refresh-token record (`refresh:{tokenHash}`), written by the registry
  // and read at the edge by the Worker on refresh. miniflare simulates KV locally (`id` is nominal).
  "kv_namespaces": [
    {
      "binding": "REFRESH_TOKEN_KV",
      "id": "nebula-auth-refresh-token-kv-test"
    }
  ],
  "services": [
    {
      "binding": "AUTH_EMAIL_SENDER",
      "service": "nebula-auth",
      "entrypoint": "NebulaEmailSender"
    }
  ],
  "ratelimits": [
    {
      "name": "NEBULA_AUTH_RATE_LIMITER",
      "namespace_id": "2001",
      "simple": {
        "limit": 100,
        "period": 60
      }
    },
    // Connection-keyed limiter for the routes that present no token (forged-cookie / open-route
    // faucets). A SECOND declaration because Cloudflare's rate limiter is per-binding; the key is
    // `CF-Connecting-IP` with allow-on-absent, so this lane (where miniflare supplies no such
    // header) never collapses every caller onto one key.
    {
      "name": "NEBULA_AUTH_CONNECTION_RATE_LIMITER",
      "namespace_id": "2002",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ],
  "vars": {
    "PRIMARY_JWT_KEY": "BLUE"
  }
}
