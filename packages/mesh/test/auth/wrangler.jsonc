{
  "name": "mesh-auth",
  "main": "test-worker-and-dos.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTH_REGISTRY",
        "class_name": "AuthRegistry"
      },
      {
        "name": "BARE_STORAGE_DO",
        "class_name": "BareStorageDO"
      },
      // The consent route reaches a person's Profile through the `@rawRpc()` bridge, so this lane
      // binds it as every Worker that runs that route does.
      {
        "name": "PROFILE",
        "class_name": "Profile"
      }
    ]
  },
  // DO class registry (NOT SQL migration). The per-scope NebulaAuth DO is dissolved
  // (tasks/nebula-auth-surrogate-sub.md) — only the singleton registry remains.
  "exports": {
    "AuthRegistry": { "type": "durable-object", "storage": "sqlite" },
    "BareStorageDO": { "type": "durable-object", "storage": "sqlite" },
    "Profile": { "type": "durable-object", "storage": "sqlite" }
  },
  // Workers KV — the ONE hot refresh-token record (`refresh:{tokenHash}`), written by the registry
  // and read at the edge by the Worker on refresh. miniflare simulates KV locally (`id` is nominal).
  "kv_namespaces": [
    {
      "binding": "REFRESH_TOKEN_KV",
      "id": "nebula-auth-refresh-token-kv-test"
    }
  ],
  "services": [
    {
      "binding": "AUTH_EMAIL_SENDER",
      "service": "mesh-auth",
      "entrypoint": "AuthEmailSender"
    }
  ],
  "ratelimits": [
    // Connection-keyed limiter for the routes that present no token (forged-cookie / open-route
    // faucets). The key is `CF-Connecting-IP` with allow-on-absent, so this lane (where miniflare
    // supplies no such header) never collapses every caller onto one key.
    {
      "name": "AUTH_CONNECTION_RATE_LIMITER",
      "namespace_id": "2002",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ],
  "vars": {
    "PRIMARY_JWT_KEY": "BLUE",
    // The deployment's origin, which every host and the JWT issuer derive from (`src/hosts.ts`).
    "LUMENIZE_ORIGIN": "http://lumenize.localhost"
  }
}
