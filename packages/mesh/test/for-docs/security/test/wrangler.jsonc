{
  "name": "mesh-security-test",
  "main": "./test-harness.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSPACE_DO",
        "class_name": "WorkspaceDO"
      },
      {
        "name": "USER_PROFILE_DO",
        "class_name": "UserProfileDO"
      },
      {
        "name": "TEAM_DOC_DO",
        "class_name": "TeamDocDO"
      },
      {
        "name": "GATE_PAIR_DO",
        "class_name": "GatePairDO"
      },
      {
        "name": "AUTH_REGISTRY",
        "class_name": "AuthRegistry"
      },
      {
        "name": "PROFILE",
        "class_name": "Profile"
      }
    ]
  },
  "services": [
    {
      "binding": "AUTH_FACADE",
      "service": "mesh-security-test",
      "entrypoint": "AuthFacade"
    }
  ],
  "exports": {
    "WorkspaceDO": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "UserProfileDO": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "TeamDocDO": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "GatePairDO": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "AuthRegistry": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "Profile": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "kv_namespaces": [
    {
      "binding": "REFRESH_TOKEN_KV",
      "id": "mesh-security-test-refresh-token-kv"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_CONNECTION_RATE_LIMITER",
      "namespace_id": "2002",
      "simple": {
        "limit": 1000,
        "period": 60
      }
    }
  ],
  "vars": {
    "PRIMARY_JWT_KEY": "BLUE",
    "LUMENIZE_ORIGIN": "http://lumenize.localhost"
  }
}
