{
  "name": "mesh-security",
  "main": "index.ts",
  "compatibility_date": "2026-03-12",
  "durable_objects": {
    "bindings": [
      {
        "name": "LUMENIZE_CLIENT_GATEWAY",
        "class_name": "LumenizeClientGateway"
      },
      {
        "name": "PROTECTED_DO",
        "class_name": "UserProfileDO"
      },
      {
        "name": "TEAM_DOC_DO",
        "class_name": "TeamDocDO"
      },
      {
        "name": "LUMENIZE_AUTH",
        "class_name": "LumenizeAuth"
      }
    ]
  },
  "exports": {
    "LumenizeClientGateway": { "type": "durable-object", "storage": "sqlite" },
    "UserProfileDO": { "type": "durable-object", "storage": "sqlite" },
    "TeamDocDO": { "type": "durable-object", "storage": "sqlite" },
    "LumenizeAuth": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    "PRIMARY_JWT_KEY": "BLUE",
    "LUMENIZE_AUTH_REDIRECT": "/app"
  }
}
