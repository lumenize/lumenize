{
  "name": "mesh-calls",
  "main": "index.ts",
  "compatibility_date": "2026-03-12",
  "durable_objects": {
    "bindings": [
      {
        "name": "LUMENIZE_CLIENT_GATEWAY",
        "class_name": "LumenizeClientGateway"
      },
      {
        "name": "DOCUMENT_DO",
        "class_name": "DocumentDO"
      },
      {
        "name": "CALCULATOR_DO",
        "class_name": "CalculatorDO"
      },
      {
        "name": "LUMENIZE_AUTH",
        "class_name": "LumenizeAuth"
      }
    ]
  },
  "services": [
    {
      "binding": "SPELLCHECK_WORKER",
      "service": "mesh-calls",
      "entrypoint": "SpellCheckWorker"
    },
    {
      "binding": "ANALYTICS_WORKER",
      "service": "mesh-calls",
      "entrypoint": "AnalyticsWorker"
    }
  ],
  "exports": {
    "LumenizeClientGateway": { "type": "durable-object", "storage": "sqlite" },
    "DocumentDO": { "type": "durable-object", "storage": "sqlite" },
    "LumenizeAuth": { "type": "durable-object", "storage": "sqlite" },
    "CalculatorDO": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    "PRIMARY_JWT_KEY": "BLUE",
    "LUMENIZE_AUTH_REDIRECT": "/app"
  }
}
