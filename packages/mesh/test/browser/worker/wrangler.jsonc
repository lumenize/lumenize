{
  "name": "lumenize-mesh-browser-e2e",
  "main": "./index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSPACE_DO",
        "class_name": "WorkspaceDO"
      },
      {
        "name": "DOCUMENT_DO",
        "class_name": "DocumentDO"
      },
      {
        "name": "AUTH_REGISTRY",
        "class_name": "AuthRegistry"
      },
      {
        "name": "PROFILE",
        "class_name": "Profile"
      }
    ]
  },
  "services": [
    {
      "binding": "SPELLCHECK_WORKER",
      "service": "lumenize-mesh-browser-e2e",
      "entrypoint": "SpellCheckWorker"
    },
    {
      "binding": "AUTH_FACADE",
      "service": "lumenize-mesh-browser-e2e",
      "entrypoint": "AuthFacade"
    },
    {
      "binding": "AUTH_EMAIL_SENDER",
      "service": "lumenize-mesh-browser-e2e",
      "entrypoint": "AuthEmailSender"
    }
  ],
  "exports": {
    "WorkspaceDO": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "DocumentDO": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "AuthRegistry": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "Profile": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "kv_namespaces": [
    {
      "binding": "REFRESH_TOKEN_KV",
      "id": "lumenize-mesh-browser-e2e-refresh-token-kv"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_CONNECTION_RATE_LIMITER",
      "namespace_id": "2002",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ],
  "vars": {
    "PRIMARY_JWT_KEY": "BLUE",
    "LUMENIZE_ORIGIN": "http://lumenize.localhost",
    // Magic links go through Resend and land in the `lumenize-test.dev` catch-all the deployed
    // `email-test` Worker reads. A `send_email` binding send to a per-run address would count
    // against Cloudflare's daily quota (experiments/email-quota-probe/RESULTS.md).
    "EMAIL_PROVIDER": "resend"
  }
}
