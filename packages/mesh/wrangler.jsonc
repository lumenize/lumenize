{
  "name": "lumenize-base",
  "main": "test/test-worker-and-dos.ts",
  "compatibility_date": "2026-10-01",
  "services": [
    {
      "binding": "TEST_WORKER",
      "service": "lumenize-base",
      "entrypoint": "TestWorker"
    },
    {
      "binding": "AUTH_FACADE",
      "service": "lumenize-base",
      "entrypoint": "AuthFacade"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TEST_DO",
        "class_name": "TestDO"
      },
      {
        "name": "USERS_DO",
        "class_name": "UsersDO"
      },
      {
        "name": "NOTIFICATIONS_DO",
        "class_name": "NotificationsDO"
      },
      {
        "name": "NADIS_PLUGIN_TEST_DO",
        "class_name": "NadisPluginTestDO"
      },
      {
        "name": "ONSTART_TEST_DO",
        "class_name": "OnStartTestDO"
      },
      {
        "name": "ONSTART_ERROR_DO",
        "class_name": "OnStartErrorDO"
      },
      {
        "name": "ECHO_DO",
        "class_name": "EchoDO"
      },
      // Every scope's node: the Clients on a scope's pages connect to it (test/support/test-auth.ts).
      {
        "name": "CLIENT_HOST_DO",
        "class_name": "ClientHostDO"
      },
      {
        "name": "CUSTOM_HOST_DO",
        "class_name": "CustomHostDO"
      },
      {
        "name": "ALARM_TEST_DO",
        "class_name": "AlarmTestDO"
      },
      {
        "name": "TASK_SCHEDULER_DO",
        "class_name": "TaskSchedulerDO"
      },
      {
        "name": "ON_REQUEST_TEST_DO",
        "class_name": "OnRequestTestDO"
      },
      {
        "name": "REJECTING_DO",
        "class_name": "RejectingDO"
      },
      {
        "name": "MARKER_REJECTING_DO",
        "class_name": "MarkerRejectingDO"
      },
      {
        "name": "MEMBER_KIND_DO",
        "class_name": "MemberKindDO"
      },
      {
        "name": "ROOM_DO",
        "class_name": "RoomDO"
      },
      // Mesh's auth: the Registry every login goes through, and the Profile the consent route reaches.
      {
        "name": "AUTH_REGISTRY",
        "class_name": "AuthRegistry"
      },
      {
        "name": "PROFILE",
        "class_name": "Profile"
      }
    ]
  },
  "exports": {
    "TestDO": { "type": "durable-object", "storage": "sqlite" },
    "UsersDO": { "type": "durable-object", "storage": "sqlite" },
    "NotificationsDO": { "type": "durable-object", "storage": "sqlite" },
    "NadisPluginTestDO": { "type": "durable-object", "storage": "sqlite" },
    "OnStartTestDO": { "type": "durable-object", "storage": "sqlite" },
    "OnStartErrorDO": { "type": "durable-object", "storage": "sqlite" },
    "EchoDO": { "type": "durable-object", "storage": "sqlite" },
    "ClientHostDO": { "type": "durable-object", "storage": "sqlite" },
    "CustomHostDO": { "type": "durable-object", "storage": "sqlite" },
    "AlarmTestDO": { "type": "durable-object", "storage": "sqlite" },
    "TaskSchedulerDO": { "type": "durable-object", "storage": "sqlite" },
    "OnRequestTestDO": { "type": "durable-object", "storage": "sqlite" },
    "RejectingDO": { "type": "durable-object", "storage": "sqlite" },
    "MarkerRejectingDO": { "type": "durable-object", "storage": "sqlite" },
    "MemberKindDO": { "type": "durable-object", "storage": "sqlite" },
    "RoomDO": { "type": "durable-object", "storage": "sqlite" },
    "AuthRegistry": { "type": "durable-object", "storage": "sqlite" },
    "Profile": { "type": "durable-object", "storage": "sqlite" }
  },
  // The refresh-token records the Registry writes and the refresh route reads.
  "kv_namespaces": [
    {
      "binding": "REFRESH_TOKEN_KV",
      "id": "mesh-refresh-token-kv-test"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_CONNECTION_RATE_LIMITER",
      "namespace_id": "2002",
      "simple": {
        "limit": 1000,
        "period": 60
      }
    }
  ],
  "vars": {
    "PRIMARY_JWT_KEY": "BLUE",
    // The deployment's origin, from which every host and the token issuer derive.
    "LUMENIZE_ORIGIN": "http://lumenize.localhost"
  }
}
