# Local development secrets
# Copy this file to .dev.vars and fill in the values

# The token the deployed `test-endpoints` and `email-test` Workers check (tooling/), so it must
# match theirs: every email waiter and the fetch suites present it.
TEST_TOKEN=your-test-token-here

# Test endpoints URL
# Default: https://test-endpoints.transformation.workers.dev
# For your own deployment: https://your-test-endpoints.workers.dev
TEST_ENDPOINTS_URL=https://test-endpoints.transformation.workers.dev

# Cloudflare Log Explorer API token (for http_requests, firewall_events datasets). No code reads it:
# the coding agent queries production's request and firewall logs with it when debugging.
# Create at: Cloudflare Dashboard → Analytics & Logs → Logs → Log Explorer
CLOUDFLARE_LOG_QUERY_TOKEN=your-log-query-token-here

# Programatically access Cloudflare Logpush logs pushed to R2
# Full URL to R2 bucket (includes account ID and bucket name)
CLOUDFLARE_R2_LOGPUSH_URL=https://YOUR-ACCOUNT-ID.r2.cloudflarestorage.com/YOUR-BUCKET-NAME

# R2 bucket name for Logpush (e.g., cloudflare-managed-03e4752d)
CLOUDFLARE_R2_BUCKET_NAME=your-bucket-name

# Cloudflare account ID — an identifier, not a secret, and the ONE line that names it. Read by the
# R2 scripts (same id as in the R2 URL), the Workers AI REST URL (`Galaxy#callModelRest`), the
# harness's deployed `deleted-on-cloudflare` scenario, and the CI lanes.
CLOUDFLARE_ACCOUNT_ID=your-account-id

# R2 API credentials for bucket access
# Create at: Cloudflare Dashboard → R2 → Manage R2 API Tokens
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Cloudflare global API key — the account's master key, sent with the login email as X-Auth-Key.
# No code reads it. The coding agent uses it only when asked to, for what no scoped token reaches.
# Find at: Cloudflare Dashboard → My Profile → API Tokens → Global API Key
CLOUDFLARE_GLOBAL_API_KEY=your-global-api-key-here

# Debug logging (see @lumenize/debug for patterns). A namespace enables itself and its children.
# Examples: nebula, nebula.Galaxy.model, lmz.mesh, *
# ⚠️ Every key in `.dev.vars` overrides the same name in a Worker's `wrangler.jsonc` vars, an empty
# one included, and apps/nebula's config sets a DEBUG default. DELETE this line in your copy to keep
# that default; an empty DEBUG silences it. The line stays here because the generated `Env` reads it.
DEBUG=

# @lumenize/auth configuration
# See https://lumenize.com/docs/auth/configuration#what-mustmight-be-in-env for all options
#
# Bootstrap-admin emails: the base @lumenize/auth DO and Mesh's auth Registry are SEPARATE DOs
# with SEPARATE vars — this is NOT a duplicate/typo. Set BOTH; never rename or delete either.
#   LUMENIZE_AUTH_BOOTSTRAP_EMAIL — base @lumenize/auth LumenizeAuth DO (lumenize-auth.ts).
#   AUTH_BOOTSTRAP_EMAIL          — Mesh's AuthRegistry (packages/mesh/src/auth/auth-registry.ts);
#                                   at the reserved _platform instance this email becomes a `*`
#                                   super-admin.
# First subject to log in with a bootstrap email is auto-promoted to admin. Both accept a
# COMMA-SEPARATED list (`a@x.io, b@y.io`) — every listed email is promoted (whitespace/case are
# normalized per entry). Privilege-granting, so in TESTS these belong in vitest miniflare.bindings,
# and in PROD they are `wrangler secret put` secrets — NEVER a committed wrangler-config var.
LUMENIZE_AUTH_BOOTSTRAP_EMAIL=you@example.com
AUTH_BOOTSTRAP_EMAIL=you@example.com,teammate@example.com
# Relative (/app) or absolute (https://example.com/app)
LUMENIZE_AUTH_REDIRECT=/app
# Access-token lifetime in seconds, honoured only when SHORTER than Mesh auth's 900. Leave it
# empty: the /live scenario that waits out a real token lapse sets it for its own boot.
AUTH_ACCESS_TOKEN_TTL=
# LUMENIZE_AUTH_ISSUER=https://lumenize.local
# LUMENIZE_AUTH_AUDIENCE=https://lumenize.local
# LUMENIZE_AUTH_ACCESS_TOKEN_TTL=900
# LUMENIZE_AUTH_REFRESH_TOKEN_TTL=2592000
# LUMENIZE_AUTH_MAGIC_LINK_TTL=1800
# LUMENIZE_AUTH_INVITE_TTL=604800
# LUMENIZE_AUTH_PREFIX=/auth

# Cloudflare Turnstile (get your secret key at: https://dash.cloudflare.com/turnstile).
# ⚠️ LEAVE UNSET for local dev + the test suites: an absent/empty key is the one sanctioned skip
# (`checkTurnstile` no longer short-circuits on the test-mode binding). The vitest configs bind
# TURNSTILE_SECRET_KEY='' explicitly so a value here cannot reach them, but `wrangler dev` reads
# this file directly — a real key here sends every local login at a real `siteverify`.
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key-here

# Turnstile BYPASS token — a high-entropy secret that lets the trusted `/live` prod-drive skip
# Turnstile (`checkTurnstile` in Mesh's auth router) by presenting it as the `x-lumenize-turnstile-bypass`
# header. Turnstile stays ON for every request without it. Skips ONLY the anti-bot gate, never auth.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Secret — set via `wrangler secret put AUTH_TURNSTILE_BYPASS_TOKEN`; NEVER a committed config.
# Empty here turns the bypass off; `apps/nebula/harness/prod.ts` needs production's value.
AUTH_TURNSTILE_BYPASS_TOKEN=

# JWT keys for @lumenize/auth (Ed25519)
# Generate with: node -e "const c=require('crypto');const{publicKey,privateKey}=c.generateKeyPairSync('ed25519');console.log('PRIVATE:',JSON.stringify(privateKey.export({type:'pkcs8',format:'pem'})));console.log('PUBLIC:',JSON.stringify(publicKey.export({type:'spki',format:'pem'})))"

# | Day | Action        | Set PRIMARY_JWT_KEY to |
# |-----|---------------|------------------------|
# |   0 | Initial setup | BLUE                   |
# |  90 | Replace GREEN | GREEN                  |
# | 180 | Replace BLUE  | BLUE                   |
# | 270 | Replace GREEN | GREEN                  |

# BLUE key pair (test keys - not for production)
JWT_PRIVATE_KEY_BLUE="-----BEGIN PRIVATE KEY-----\nMC4C...\n-----END PRIVATE KEY-----\n"
JWT_PUBLIC_KEY_BLUE="-----BEGIN PUBLIC KEY-----\nMCow...\n-----END PUBLIC KEY-----\n"

# GREEN key pair (for rotation testing - test keys, not for production)
JWT_PRIVATE_KEY_GREEN="-----BEGIN PRIVATE KEY-----\nMC4C...\n-----END PRIVATE KEY-----\n"
JWT_PUBLIC_KEY_GREEN="-----BEGIN PUBLIC KEY-----\nMCow...\n-----END PUBLIC KEY-----\n"

# PRIMARY_JWT_KEY (the BLUE/GREEN selector) lives in each worker's wrangler.jsonc "vars" — not here.
# These keys sign for local stacks and the deployed test target. Production signs with a key pair of
# its own, generated for it and set only as its Worker secrets, so a token minted here never verifies
# there (apps/nebula/scripts/deploy.sh).

# The deployed test target's own refresh-token KV namespace id (`wrangler kv namespace create`).
# apps/nebula/scripts/deploy-test.sh refuses to run without it, since wrangler.jsonc names production's.
# TEST_REFRESH_TOKEN_KV_ID=

# The deployed test target's certificate zone, `lumenize-test.dev`: its zone id, which deploy-test.sh
# writes into the test config and refuses to run without, and a token scoped to that zone's SSL and
# Certificates, which is set as `test-nebula`'s CERTIFICATE_API_TOKEN secret (deploy-test.sh's header
# shows how). A galaxy orders and deletes its certificate pack with them (apps/nebula/src/certificate.ts).
# TEST_CERTIFICATE_ZONE_ID=
# TEST_CERTIFICATE_API_TOKEN=

# Production's counterpart: a token scoped to `lumenize.dev`'s SSL and Certificates, the one to set as
# the production Worker's CERTIFICATE_API_TOKEN secret, and what the coding agent reads production's
# certificate packs with. Production's zone id is CERTIFICATE_ZONE_ID in apps/nebula/wrangler.jsonc.
# PROD_CERTIFICATE_API_TOKEN=

# A deployed `https` Worker's own certificate token, set as its secret, never here: an `http` local
# stack orders no certificate, so leave it empty. Named so the generated `Env` types it.
CERTIFICATE_API_TOKEN=

# A token with Account → Workers Scripts → Read, with which the deployed pass lists a test app's
# Durable Objects to confirm a deletion wiped them (the `deleted-on-cloudflare` scenario).
# CLOUDFLARE_WORKERS_READ_TOKEN=

# Optional — only needed if you use ResendEmailSender (see https://lumenize.com/docs/auth/using-resend-instead).
# CloudflareEmailSender (the default) uses the EMAIL binding and needs no secret.
# Resend account: larry@lumenize.com
RESEND_API_KEY="re_..."

# The signing secret of Resend's webhook to the deployed `email-test` Worker (tooling/email-test),
# which checks each delivery event with it and pushes it to the email waiters by recipient. Set as
# that Worker's secret (`wrangler secret put`); its tests bind their own.
# RESEND_WEBHOOK_SECRET=whsec_...

# CLOUDFLARE_API_TOKEN does NOT belong here. wrangler reads it from the process environment, never
# from `.dev.vars`, to authenticate remote bindings where there is no `wrangler login` session
# (CI's job env; see `.github/workflows/ci.yml`). A line here would only type a bogus `Env` member.

# Studio's codegen model (`Galaxy#callModelRest`, apps/nebula/src/galaxy.ts).
# WORKERS_AI_TOKEN: a scoped Workers-AI REST token. When set, the Galaxy uses the REST
# transport, which builds its URL from CLOUDFLARE_ACCOUNT_ID above (works in every lane, incl.
# secret-less hosted where the `env.AI` binding can't authenticate); when empty, it falls back
# to the `env.AI` binding, which `wrangler dev` authenticates with your `wrangler login`. Leave it
# empty unless you need REST: any value at all switches the lane. A deployed Worker needs neither
# this nor the account id, since its binding authenticates itself.
WORKERS_AI_TOKEN=
# CF_AI_GATEWAY: an AI Gateway id, sent as `cf-aig-gateway-id` on the same REST URL. LEAVE EMPTY:
# naming a gateway turns on account-side logging of every prompt and reply, a data-handling
# decision (see `Galaxy#callModelRest`'s JSDoc). Empty and absent behave the same.
CF_AI_GATEWAY=

# An Anthropic API key. No code reads it yet: Claude Opus is an allowed eval judge in
# tasks/on-hold/nebula-studio-self-improvement.md, and the coding agent can compare models with it.
ANTHROPIC_API_KEY=sk-ant-...
