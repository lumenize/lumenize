# Local development secrets
# Copy this file to .dev.vars and fill in the values

# Test token for test-endpoints service
# For local dev, use: lumenize-test-local-dev-2025
# Must match the token configured in your test-endpoints deployment
TEST_TOKEN=your-test-token-here

# Test endpoints URL
# Default: https://test-endpoints.transformation.workers.dev
# For your own deployment: https://your-test-endpoints.workers.dev
TEST_ENDPOINTS_URL=https://test-endpoints.transformation.workers.dev

# Cloudflare Log Explorer API token (for http_requests, firewall_events datasets)
# Create at: Cloudflare Dashboard → Analytics & Logs → Logs → Log Explorer
CLOUDFLARE_LOG_QUERY_TOKEN=your-log-query-token-here

# Programatically access Cloudflare Logpush logs pushed to R2
# Full URL to R2 bucket (includes account ID and bucket name)
CLOUDFLARE_R2_LOGPUSH_URL=https://YOUR-ACCOUNT-ID.r2.cloudflarestorage.com/YOUR-BUCKET-NAME

# R2 bucket name for Logpush (e.g., cloudflare-managed-03e4752d)
CLOUDFLARE_R2_BUCKET_NAME=your-bucket-name

# Cloudflare account ID (same as in R2 URL)
CLOUDFLARE_ACCOUNT_ID=your-account-id

# R2 API credentials for bucket access
# Create at: Cloudflare Dashboard → R2 → Manage R2 API Tokens
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Cloudflare global API key
# Find at: Cloudflare Dashboard → My Profile → API Tokens → Global API Key
CLOUDFLARE_GLOBAL_API_KEY=your-global-api-key-here

# Debug logging (see @lumenize/debug for patterns)
# Examples: proxy-fetch.*, rpc.*, *
# Leave empty to disable
DEBUG=

# @lumenize/auth configuration
# See https://lumenize.com/docs/auth/configuration#what-mustmight-be-in-env for all options
#
# Bootstrap-admin emails: the base @lumenize/auth DO and the nebula-auth DO are SEPARATE DOs
# with SEPARATE vars — this is NOT a duplicate/typo. Set BOTH; never rename or delete either.
#   LUMENIZE_AUTH_BOOTSTRAP_EMAIL — base @lumenize/auth LumenizeAuth DO (lumenize-auth.ts).
#   NEBULA_AUTH_BOOTSTRAP_EMAIL   — nebula-auth NebulaAuth DO (nebula-auth.ts); at the reserved
#                                   nebula-platform instance this email becomes a `*` super-admin.
# First subject to log in with a bootstrap email is auto-promoted to admin. Both accept a
# COMMA-SEPARATED list (`a@x.io, b@y.io`) — every listed email is promoted (whitespace/case are
# normalized per entry). Privilege-granting, so in TESTS these belong in vitest miniflare.bindings,
# and in PROD they are `wrangler secret put` secrets — NEVER a committed wrangler-config var.
LUMENIZE_AUTH_BOOTSTRAP_EMAIL=you@example.com
NEBULA_AUTH_BOOTSTRAP_EMAIL=you@example.com,teammate@example.com
# Relative (/app) or absolute (https://example.com/app)
LUMENIZE_AUTH_REDIRECT=/app
# LUMENIZE_AUTH_ISSUER=https://lumenize.local
# LUMENIZE_AUTH_AUDIENCE=https://lumenize.local
# LUMENIZE_AUTH_ACCESS_TOKEN_TTL=900
# LUMENIZE_AUTH_REFRESH_TOKEN_TTL=2592000
# LUMENIZE_AUTH_MAGIC_LINK_TTL=1800
# LUMENIZE_AUTH_INVITE_TTL=604800
# LUMENIZE_AUTH_PREFIX=/auth

# Cloudflare Turnstile (get your secret key at: https://dash.cloudflare.com/turnstile).
# ⚠️ LEAVE UNSET for local dev + the test suites: an absent/empty key is the one sanctioned skip
# (`checkTurnstile` no longer short-circuits on the test-mode binding). The vitest configs bind
# TURNSTILE_SECRET_KEY='' explicitly so a value here cannot reach them, but `wrangler dev` reads
# this file directly — a real key here sends every local login at a real `siteverify`.
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key-here

# Turnstile BYPASS token — a high-entropy secret that lets the trusted `/live` prod-drive skip
# Turnstile (nebula-auth router.checkTurnstile) by presenting it as the `x-lumenize-turnstile-bypass`
# header. Turnstile stays ON for every request without it. Skips ONLY the anti-bot gate, never auth.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Secret — set via `wrangler secret put NEBULA_AUTH_TURNSTILE_BYPASS_TOKEN`; NEVER a committed config.
NEBULA_AUTH_TURNSTILE_BYPASS_TOKEN=generate-a-32-byte-base64url-token

# JWT keys for @lumenize/auth (Ed25519)
# Generate with: node -e "const c=require('crypto');const{publicKey,privateKey}=c.generateKeyPairSync('ed25519');console.log('PRIVATE:',JSON.stringify(privateKey.export({type:'pkcs8',format:'pem'})));console.log('PUBLIC:',JSON.stringify(publicKey.export({type:'spki',format:'pem'})))"

# | Day | Action        | Set PRIMARY_JWT_KEY to |
# |-----|---------------|------------------------|
# |   0 | Initial setup | BLUE                   |
# |  90 | Replace GREEN | GREEN                  |
# | 180 | Replace BLUE  | BLUE                   |
# | 270 | Replace GREEN | GREEN                  |

# BLUE key pair (test keys - not for production)
JWT_PRIVATE_KEY_BLUE="-----BEGIN PRIVATE KEY-----\nMC4C...\n-----END PRIVATE KEY-----\n"
JWT_PUBLIC_KEY_BLUE="-----BEGIN PUBLIC KEY-----\nMCow...\n-----END PUBLIC KEY-----\n"

# GREEN key pair (for rotation testing - test keys, not for production)
JWT_PRIVATE_KEY_GREEN="-----BEGIN PRIVATE KEY-----\nMC4C...\n-----END PRIVATE KEY-----\n"
JWT_PUBLIC_KEY_GREEN="-----BEGIN PUBLIC KEY-----\nMCow...\n-----END PUBLIC KEY-----\n"

# PRIMARY_JWT_KEY (the BLUE/GREEN selector) lives in each worker's wrangler.jsonc "vars" — not here.

# Optional — only needed if you use ResendEmailSender (see https://lumenize.com/docs/auth/using-resend-instead).
# CloudflareEmailSender (the default) uses the EMAIL binding and needs no secret.
# Resend account: larry@lumenize.com
RESEND_API_KEY="re_..."

# Only needed where there's no `wrangler login` OAuth session (CI / cloud agents).
# The remote-binding proxy (e2e-email / hono `send_email remote:true`) uses your
# OAuth session locally, so these are NOT needed for local runs; in CI they come
# from GitHub Secrets as job env. The secret-less Claude-hosted lane sets
# LUMENIZE_NO_CF_REMOTE=1 instead (omits the CF-remote projects) and never gets the token.
CLOUDFLARE_API_TOKEN=cfut_...
CLOUDFLARE_ACCOUNT_ID=your-account-id

# Nebula Studio codegen model (DevStudio.callModel — apps/nebula/src/dev-studio.ts)
# WORKERS_AI_TOKEN: a scoped Workers-AI REST token. When present, DevStudio uses the REST
# transport (works in every lane, incl. secret-less hosted where the `env.AI` binding can't
# authenticate); when absent, it falls back to the `env.AI` binding (needs CF account creds).
WORKERS_AI_TOKEN=your-workers-ai-rest-token
# ANTHROPIC_API_KEY: declared secret binding (Anthropic model-provider path).
ANTHROPIC_API_KEY=sk-ant-...

# SonarCloud analysis token — CI-only (the reusable-on-success workflow's Sonar step reads it;
# provisioning fails without it). Not used by local dev; include so a fork/self-host has the slot.
SONAR_TOKEN=your-sonarcloud-token
